{
  "name": "second-brain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:mock": "vite --config vite.mock.config.ts",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && cap sync android",
    "android:check": "npm run cap:sync && node scripts/gradlew.mjs lintDebug assembleDebug",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "android:release": "npm run cap:sync && node scripts/gradlew.mjs assembleRelease bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.61.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^9.34.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "supabase": "2.122.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
